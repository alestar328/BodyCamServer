<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- Camera & audio -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Service persistence -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Upload & connectivity check -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Hardware control (sysfs nodes) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:label="FalconOne Server"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: con targetSdk 28 el HTTP en claro sale bloqueado
             por defecto, y la subida por bloques se desarrolla contra el stub de
             tools/tus_stub_server.py, que va por HTTP en la LAN. La app ya sirve
             HTTP sin cifrar (NanoHTTPD) en esa misma red.
             TODO: quitar esto cuando la subida apunte al endpoint HTTPS de Nexus. -->

        <!-- singleTop: las órdenes de mantenimiento llegan por `am start` con extras
             (ver DeviceOwner.atenderOrdenDeMantenimiento). Sin esto, con la app ya abierta
             el intent no llega a onNewIntent y la orden se pierde.
             CATEGORY_HOME: la app es el lanzador de la unidad cuando está en kiosco.
             Lo elige el device owner con addPersistentPreferredActivity, así que no
             sale el diálogo de "¿qué app usar?"; sin el rol, el filtro está pero no
             gana a la pantalla de inicio del fabricante.
             screenOrientation: la misma que RecordingActivity. El panel de la unidad
             va montado girado y se compensa en Compose (ver Rotated); si las dos
             activities no parten de la misma orientación base, el mismo giro deja
             cada pantalla mirando a un lado. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.FalconPanel"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Activity de grabación — foreground para máxima prioridad en HAL de cámara -->
        <activity
            android:name=".RecordingActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:exported="false" />

        <!-- Asistente de instalación: aprende los botones y el hardware de un modelo
             que no conocemos (ver AsistenteActivity). Misma orientación que las
             otras dos por el mismo motivo: el giro del panel es uno solo. -->
        <activity
            android:name=".AsistenteActivity"
            android:theme="@style/Theme.FalconPanel"
            android:screenOrientation="landscape"
            android:exported="false" />

        <!-- Servidor BT — persiste en background -->
        <!-- foregroundServiceType no disponible en API 28 -->
        <service
            android:name=".BtServerService"
            android:exported="false" />

        <!-- Servicio de subida en background -->
        <service
            android:name=".UploadService"
            android:exported="false" />

        <!-- Arranque automático al encender la cámara -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Administración del dispositivo: es el componente al que apunta
             `dpm set-device-owner` (ver tools/kiosco.sh). Sin él no hay kiosco. -->
        <receiver
            android:name=".FalconDeviceAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Captura de botones físicos con la app en background. Con la pantalla
             apagada puede no llegar nada: el asistente lo comprueba botón a botón. -->
        <!-- Hay que activarlo una vez por unidad. Lo hace `tools/kiosco.sh poner`
             con `settings put secure enabled_accessibility_services`: en kiosco ya
             no se llega a Ajustes → Accesibilidad, y ni un device owner puede
             encender un servicio de accesibilidad por su cuenta. -->
        <service
            android:name=".ButtonAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
